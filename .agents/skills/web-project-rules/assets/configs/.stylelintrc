{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/*.min.css"
  ],
  "reportDescriptionlessDisables": true,
  "reportInvalidScopeDisables": true,
  "reportNeedlessDisables": true,
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "config",
          "custom-variant",
          "plugin",
          "reference",
          "source",
          "theme",
          "utility",
          "variant"
        ]
      }
    ],
    "color-named": "never",
    "declaration-no-important": [true, { "severity": "warning" }],
    "selector-max-id": [0, { "ignoreSelectors": ["#root"] }]
  }
}

    "input-otp": "^1.5.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.12",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.0",
    "recharts": "^3.8.0",

# Public browser configuration only. Never put access tokens, API keys, or
# trusted user identity values in VITE_* variables because Vite bundles them
# into the client application.
VITE_BACKEND_ORIGIN=http://localhost:8000
VITE_BACKEND_PUBLIC_PREFIX=/public/
VITE_BACKEND_IMAGE_PREFIX=/api/files/
VITE_BACKEND_LINK_CHECK_PATH=/api/security/check-link

# Keep mock while the authentication backend is unavailable. Change only this
# value to api after the backend implements the shared auth gateway contract.
VITE_AUTH_DATA_SOURCE=mock

# Chat reuses VITE_BACKEND_ORIGIN for Python langgraph-api. The temporary
# frontend client sends X-User-Id: 1 until backend authentication is ready.

# Optional comma-separated additions. The required backend prefixes above are
# always included.
VITE_STREAMDOWN_ALLOWED_LINK_PREFIXES=
VITE_STREAMDOWN_ALLOWED_IMAGE_PREFIXES=
VITE_STREAMDOWN_ALLOWED_PROTOCOLS=https,mailto
